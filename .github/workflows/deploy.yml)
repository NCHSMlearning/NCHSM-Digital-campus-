name: Deploy to GitHub Pages

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch:  # Allow manual trigger

permissions:
  contents: read
  pages: write
  id-token: write

# Add environment variables for the workflow
env:
  GOOGLE_SCRIPT_URL: ${{ secrets.GOOGLE_SCRIPT_URL }}
  SENDGRID_API_KEY: ${{ secrets.SENDGRID_API_KEY }}

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
      
      - name: Generate config.js from GitHub Secrets
        run: |
          echo "🔧 Generating config.js from GitHub Secrets..."
          
          # Create config.js with environment variables
          cat > config.js << 'EOF'
          // config.js - Generated from GitHub Secrets
          // DO NOT EDIT - This file is auto-generated
          (function() {
              'use strict';
              
              // Configuration object
              var config = {
                  // Supabase Configuration
                  SUPABASE_URL: "${{ secrets.SUPABASE_URL }}",
                  SUPABASE_ANON_KEY: "${{ secrets.SUPABASE_ANON_KEY }}",
                  
                  // LocationIQ API (if needed)
                  LOCATIONIQ_API_KEY: "${{ secrets.LOCATIONIQ_API_KEY || '' }}",
                  
                  // Email Configuration
                  EMAIL_API_ENDPOINT: "/api/send-email",
                  ENABLE_EMAILS: true,
                  
                  // Finance Module Configuration
                  FINANCE_TABLE: "consolidated_user_profiles_table",
                  ALLOWED_ROLES: "superadmin,admin,finance_officer",
                  
                  // Application Info
                  BUILD_TIME: "${{ github.run_started_at }}",
                  COMMIT_SHA: "${{ github.sha }}",
                  ENVIRONMENT: "${{ github.ref == 'refs/heads/main' && 'production' || 'development' }}",
                  VERSION: "1.0.0"
              };
              
              // Validate critical configuration
              if (!config.SUPABASE_URL || !config.SUPABASE_ANON_KEY) {
                  console.error('❌ Critical configuration missing!');
              }
              
              // Make config available globally
              window.APP_CONFIG = Object.freeze(config);
              
              console.log('✅ App config loaded:', {
                  environment: config.ENVIRONMENT,
                  buildTime: config.BUILD_TIME,
                  hasSupabase: !!(config.SUPABASE_URL && config.SUPABASE_ANON_KEY)
              });
          })();
          EOF
          
          # Create finance-config.js for the Finance Module
          echo "🔧 Generating finance-config.js from GitHub Secrets..."
          mkdir -p finance-module/js
          
          cat > finance-module/js/finance-config.js << 'EOF'
          // finance-module/js/finance-config.js - Generated from GitHub Secrets
          // DO NOT EDIT - This file is auto-generated
          (function() {
              'use strict';
              
              var financeConfig = {
                  SUPABASE_URL: "${{ secrets.SUPABASE_URL }}",
                  SUPABASE_ANON_KEY: "${{ secrets.SUPABASE_ANON_KEY }}",
                  USER_TABLE: "consolidated_user_profiles_table",
                  ALLOWED_ROLES: ["superadmin", "finance_officer"],
                  APP_NAME: "NCHSM Finance Module",
                  VERSION: "2.0.0",
                  CURRENCY: "KES"
              };
              
              window.FINANCE_CONFIG = Object.freeze(financeConfig);
              
              console.log('✅ Finance Config loaded');
              console.log('📊 Using table:', financeConfig.USER_TABLE);
              console.log('👥 Allowed roles:', financeConfig.ALLOWED_ROLES.join(', '));
          })();
          EOF
          
          # Copy config to root for main app
          cp config.js js/config.js 2>/dev/null || echo "⚠️ js/ directory not found, skipping"
          
          echo "✅ Configuration files generated successfully!"
      
      - name: List generated files
        run: |
          echo "📁 Generated files:"
          ls -la config.js 2>/dev/null || echo "⚠️ config.js not found"
          ls -la finance-module/js/finance-config.js 2>/dev/null || echo "⚠️ finance-config.js not found"
          ls -la js/config.js 2>/dev/null || echo "⚠️ js/config.js not found"
      
      - name: Setup Pages
        uses: actions/configure-pages@v4
      
      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: '.'
      
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
